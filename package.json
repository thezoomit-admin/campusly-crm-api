{
  "name": "server.educational.crm",
  "private": true,
  "version": "0.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prod": "NODE_ENV=production node ./dist/server.js",
    "migrate": "node scripts/prisma-with-env.cjs migrate dev",
    "start": "node dist/server.js",
    "push": "node scripts/prisma-with-env.cjs db push",
    "generate": "node scripts/prisma-with-env.cjs generate --generator client",
    "generate:erd": "ts-node --transpile-only src/scripts/generateErDiagram.ts",
    "migrate:media-r2": "ts-node --transpile-only -r tsconfig-paths/register scripts/migrate-uploads-to-r2.ts",
    "studio": "node scripts/prisma-with-env.cjs studio",
    "build": "tsc",
    "validate": "node scripts/prisma-with-env.cjs validate",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "backfill:offers": "ts-node --transpile-only scripts/backfill-service-offers.ts",
    "prepare:offer-versions": "ts-node --transpile-only scripts/prepare-offer-versions.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "argon2": "^0.44.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "imapflow": "^2.2.5",
    "mailparser": "^3.9.35",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.16.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
