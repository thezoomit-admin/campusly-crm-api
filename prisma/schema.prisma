  deliveryStatus       String            @default("sent") @map("delivery_status")
  errorMessage         String?           @map("error_message") @db.Text
  sentById             String?           @map("sent_by_id") @db.Uuid
  templateCode         String?           @map("template_code")
  communicationEventId String?           @map("communication_event_id") @db.Uuid
  sentAt               DateTime          @default(now()) @map("sent_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  thread               EmailThread       @relation(fields: [threadId], references: [id], onDelete: Restrict)
  sentBy               User?             @relation("EmailMessageSender", fields: [sentById], references: [id], onDelete: SetNull)
  attachments          EmailAttachment[]

  @@index([threadId, sentAt])
  @@map("email_messages")
}

model EmailAttachment {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String       @map("message_id") @db.Uuid
  fileName    String       @map("file_name")
  mimeType    String       @map("mime_type")
  url         String       @db.Text
  fileSize    Int?         @map("file_size")
  docCategory String?      @map("doc_category")
  createdAt   DateTime     @default(now()) @map("created_at")
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("email_attachments")
}

model EmailTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  subject   String
  body      String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("email_templates")
}
