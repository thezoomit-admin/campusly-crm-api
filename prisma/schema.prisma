  VERIFIED
  REJECTED
  REUPLOAD_REQUIRED
  ARCHIVED

  @@map("file_document_status")
}

enum FileDocumentRequirement {
  REQUIRED
  OPTIONAL

  @@map("file_document_requirement")
}

enum FileUploadActorKind {
  EMPLOYEE
  STUDENT_PORTAL

  @@map("file_upload_actor_kind")
}

enum FileDocumentRequestMethod {
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
  OTHER

  @@map("file_document_request_method")
}

enum FileDocumentRequestStatus {
  OPEN
  FULFILLED
  CANCELLED

  @@map("file_document_request_status")
}

enum FileDocumentActivityAction {
  REQUESTED
  UPLOADED
  REVIEW_STARTED
  VERIFIED
  REJECTED
  REUPLOADED
  ARCHIVED
  PRIMARY_MARKED
  CHECKLIST_ADDED
  CHECKLIST_REMOVED
  CHECKLIST_UPDATED
  VIEWED
  DOWNLOADED

  @@map("file_document_activity_action")
}

/// CRM-009 file opened after lead conversion. Document completion is separate from file status.
model CrmFile {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String                 @unique
  leadId             String                 @unique @map("lead_id") @db.Uuid
  studentName        String                 @map("student_name")
  ownerId            String?                @map("owner_id") @db.Uuid
  status             CrmFileStatus          @default(OPEN)
  documentReadiness  FileDocumentReadiness  @default(INCOMPLETE) @map("document_readiness")
  openedById         String?                @map("opened_by_id") @db.Uuid
  openedAt           DateTime               @default(now()) @map("opened_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at")
  lead               Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner              User?                  @relation("CrmFileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  openedBy           User?                  @relation("CrmFileOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  checklistItems     FileChecklistItem[]
  documents          FileDocument[]

  @@index([ownerId])
  @@index([status])
  @@index([documentReadiness])
  @@map("crm_files")
}

model FileChecklistItem {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId       String                  @map("file_id") @db.Uuid
  categoryCode String                  @map("category_code")
  categoryName String                  @map("category_name")
  typeCode     String                  @map("type_code")
  typeName     String                  @map("type_name")
  isRequired   Boolean                 @default(true) @map("is_required")
  isActive     Boolean                 @default(true) @map("is_active")
  sortOrder    Int                     @default(0) @map("sort_order")
  addedById    String?                 @map("added_by_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at")
  file         CrmFile                 @relation(fields: [fileId], references: [id], onDelete: Cascade)
  addedBy      User?                   @relation("FileChecklistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  document     FileDocument?

  @@unique([fileId, typeCode])
  @@index([fileId, isActive, sortOrder])
  @@map("file_checklist_items")
}

model FileDocument {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                    @unique
  fileId               String                    @map("file_id") @db.Uuid
  checklistItemId      String?                   @unique @map("checklist_item_id") @db.Uuid
  categoryCode         String                    @map("category_code")
  categoryNameSnapshot String                    @map("category_name_snapshot")
  typeCode             String                    @map("type_code")
  typeNameSnapshot     String                    @map("type_name_snapshot")
  requirement          FileDocumentRequirement?
  status               FileDocumentStatus        @default(NOT_REQUESTED)
  archivedAt           DateTime?                 @map("archived_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at")
  file                 CrmFile                   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  checklistItem        FileChecklistItem?        @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  versions             FileDocumentVersion[]
  requests             FileDocumentRequest[]
  activities           FileDocumentActivity[]

  @@index([fileId, typeCode])
  @@index([fileId, status])
  @@index([status])
  @@index([archivedAt])
  @@map("file_documents")
}

model FileDocumentVersion {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId           String               @map("document_id") @db.Uuid
  versionNumber        Int                  @map("version_number")
  isLatest             Boolean              @default(true) @map("is_latest")
  documentDate         DateTime?            @map("document_date") @db.Date
  expiryDate           DateTime?            @map("expiry_date") @db.Date
  remarks              String?              @db.Text
  rejectionReasonCode  String?              @map("rejection_reason_code")
  rejectionReasonName  String?              @map("rejection_reason_name")
  rejectionRemarks     String?              @map("rejection_remarks") @db.Text
  verifiedById         String?              @map("verified_by_id") @db.Uuid
  verifiedAt           DateTime?            @map("verified_at")
  verificationRemarks  String?              @map("verification_remarks") @db.Text
  uploadedById         String?              @map("uploaded_by_id") @db.Uuid
  uploadedByKind       FileUploadActorKind  @default(EMPLOYEE) @map("uploaded_by_kind")
  createdAt            DateTime             @default(now()) @map("created_at")
  document             FileDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy           User?                @relation("FileDocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy           User?                @relation("FileDocumentVersionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  assets               FileDocumentAsset[]

  @@unique([documentId, versionNumber])
  @@index([documentId, isLatest])
  @@index([expiryDate])
  @@index([uploadedById])
  @@index([verifiedById])
  @@map("file_document_versions")
}

model FileDocumentAsset {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId  String              @map("version_id") @db.Uuid
  fileName   String              @map("file_name")
  label      String?
  mimeType   String              @map("mime_type")
  storageKey String              @map("storage_key")
  fileSize   Int                 @map("file_size")
  isPrimary  Boolean             @default(false) @map("is_primary")
  createdAt  DateTime            @default(now()) @map("created_at")
  version    FileDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, isPrimary])
  @@map("file_document_assets")
}

model FileDocumentRequest {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                    @unique
  documentId           String                    @map("document_id") @db.Uuid
  requestedById        String?                   @map("requested_by_id") @db.Uuid
  dueDate              DateTime?                 @map("due_date") @db.Date
  method               FileDocumentRequestMethod
  remarks              String?                   @db.Text
  status               FileDocumentRequestStatus @default(OPEN)
  activityId           String?                   @map("activity_id") @db.Uuid
  communicationEventId String?                   @map("communication_event_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at")
  document             FileDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy          User?                     @relation("FileDocumentRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([requestedById])
  @@index([dueDate])
  @@map("file_document_requests")
}

model FileDocumentActivity {
  id         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String                     @map("document_id") @db.Uuid
  action     FileDocumentActivityAction
  notes      String?                    @db.Text
  metadata   Json?
  userId     String?                    @map("user_id") @db.Uuid
  createdAt  DateTime                   @default(now()) @map("created_at")
  document   FileDocument               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User?                      @relation("FileDocumentActivityActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([userId])
  @@map("file_document_activities")
}
