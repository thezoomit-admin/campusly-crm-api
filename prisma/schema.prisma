generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum PasswordTokenPurpose {
  RESET
  INVITE
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum PackageItemInclusion {
  INCLUDED
  OPTIONAL
}

enum DataScope {
  OWN
  TEAM
  DEPARTMENT
  ALL
}

enum OverrideEffect {
  ALLOW
  DENY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum EmployeeDocumentType {
  NID
  PHOTOGRAPH
  CV
  EDUCATIONAL_CERTIFICATE
  APPOINTMENT_LETTER
  JOINING_DOCUMENT
  OTHER
}

enum ActivityType {
  CALL
  MESSAGE
  WHATSAPP
  EMAIL
  SMS
  COUNSELLING
  MEETING
  DOCUMENT_REQUEST
  PAYMENT_DISCUSSION
  SERVICE_DISCUSSION
  NOTE
  FOLLOW_UP
  OTHER
}

model Department {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String       @unique
  name        String
  description String?
  sortOrder   Int          @default(0) @map("sort_order")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")
  teams       Team[]
  users       User[]
  employees   Employee[]

  @@map("departments")
}

model Team {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String       @unique
  name         String
  description  String?
  sortOrder    Int          @default(0) @map("sort_order")
  departmentId String       @map("department_id") @db.Uuid
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users        User[]
  employees    Employee[]
  assignedLeads Lead[]                      @relation("LeadCountryTeam")
  countryRules  CountryAssignmentRule[]

  @@index([departmentId])
  @@map("teams")
}

model User {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName            String        @default("User") @map("full_name")
  email               String        @unique
  username            String        @unique
  mobile              String        @default("01700000000")
  passwordHash        String        @map("password_hash")
  photoUrl            String?       @map("photo_url")
  status              UserStatus    @default(ACTIVE)
  departmentId        String?       @map("department_id") @db.Uuid
  teamId              String?       @map("team_id") @db.Uuid
  primaryRoleId       String?       @map("primary_role_id") @db.Uuid
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  lastLoginAt         DateTime?     @map("last_login_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  department          Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team                Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  primaryRole         Role?         @relation("UserPrimaryRole", fields: [primaryRoleId], references: [id], onDelete: Restrict)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  permissionOverrides UserPermissionOverride[]
  dataScopes          UserDataScope[]
  roleHistory         RoleHistory[]          @relation("RoleHistoryUser")
  roleChangesMade     RoleHistory[]          @relation("RoleHistoryActor")
  permissionHistory   PermissionHistory[]    @relation("PermissionHistoryUser")
  permissionChangesMade PermissionHistory[]  @relation("PermissionHistoryActor")
  auditLogs           AuditLog[]
  activities          Activity[]
  masterDataCreated   MasterDataItem[]       @relation("MasterDataCreatedBy")
  masterDataUpdated   MasterDataItem[]       @relation("MasterDataUpdatedBy")
  employee            Employee?
  ownedLeads          Lead[]                 @relation("LeadOwner")
  createdLeads        Lead[]                 @relation("LeadCreatedBy")
  updatedLeads        Lead[]                 @relation("LeadUpdatedBy")
  assignmentFrom      LeadAssignment[]       @relation("AssignmentFrom")
  assignmentTo        LeadAssignment[]       @relation("AssignmentTo")
  assignmentsMade     LeadAssignment[]       @relation("AssignmentActor")
  qualificationHistory LeadQualificationHistory[]
  statusHistory        LeadStatusHistory[]
  defaultCountryRules CountryAssignmentRule[] @relation("CountryRuleDefaultOwner")
  counselledApplications Application[]       @relation("ApplicationCounsellor")
  counselledStudents  Student[]              @relation("StudentCounsellor")
  uploadedDocuments   CrmDocument[]          @relation("DocumentUploader")
  uploadedLeadDocuments LeadDocument[]       @relation("LeadDocumentUploader")
  verifiedLeadDocuments LeadDocument[]       @relation("LeadDocumentVerifier")
  leadDocumentActivities LeadDocumentActivity[] @relation("LeadDocumentActivityActor")
  authoredLeadNotes   LeadNote[]             @relation("LeadNoteAuthor")
  ownedFollowUps      FollowUp[]             @relation("FollowUpOwner")
  notifications       Notification[]         @relation("NotificationRecipient")
  campaignsCreated    Campaign[]             @relation("CampaignCreatedBy")
  campaignsUpdated    Campaign[]             @relation("CampaignUpdatedBy")
  attributionChanges  LeadAttributionChange[]
  whatsappConversationsAssigned WhatsAppConversation[] @relation("WhatsAppConversationAssignee")
  whatsappMessagesSent WhatsAppMessage[]     @relation("WhatsAppMessageSender")
  emailThreadsAssigned EmailThread[]         @relation("EmailThreadAssignee")
  emailMessagesSent    EmailMessage[]        @relation("EmailMessageSender")
  serviceItemsCreated  ServiceItem[]         @relation("ServiceItemCreatedBy")
  serviceItemsUpdated  ServiceItem[]         @relation("ServiceItemUpdatedBy")
  packagesCreated      Package[]             @relation("PackageCreatedBy")
  packagesUpdated      Package[]             @relation("PackageUpdatedBy")
  packageVersionsCreated PackageVersion[]    @relation("PackageVersionCreatedBy")
  serviceOffersCreated ServiceOffer[]        @relation("ServiceOfferCreatedBy")
  serviceOffersUpdated ServiceOffer[]        @relation("ServiceOfferUpdatedBy")
  serviceOffersGenerated ServiceOffer[]      @relation("ServiceOfferGeneratedBy")
  serviceOffersSent    ServiceOffer[]        @relation("ServiceOfferSentBy")
  serviceOffersAccepted ServiceOffer[]       @relation("ServiceOfferAcceptedBy")
  serviceOffersCancelled ServiceOffer[]      @relation("ServiceOfferCancelledBy")
  serviceOfferStatusChanges ServiceOfferStatusHistory[] @relation("ServiceOfferStatusChangedBy")
  serviceOfferPaymentsRecorded ServiceOfferInstallment[] @relation("ServiceOfferInstallmentPaidBy")
  paymentsReceived             Payment[]                 @relation("PaymentReceivedBy")
  paymentsCreated              Payment[]                 @relation("PaymentCreatedBy")
  paymentsCancelled            Payment[]                 @relation("PaymentCancelledBy")
  paymentsReversed             Payment[]                 @relation("PaymentReversedBy")
  receiptsGenerated            Receipt[]                 @relation("ReceiptGeneratedBy")
  ownedCrmFiles                CrmFile[]                 @relation("CrmFileOwner")
  openedCrmFiles               CrmFile[]                 @relation("CrmFileOpenedBy")
  fileChecklistItemsAdded      FileChecklistItem[]       @relation("FileChecklistAddedBy")
  uploadedFileDocumentVersions FileDocumentVersion[]     @relation("FileDocumentVersionUploader")
  verifiedFileDocumentVersions FileDocumentVersion[]     @relation("FileDocumentVersionVerifier")
  fileDocumentRequests         FileDocumentRequest[]     @relation("FileDocumentRequester")
  fileDocumentActivities       FileDocumentActivity[]    @relation("FileDocumentActivityActor")

  @@index([primaryRoleId])
  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  name        String
  description String?
  status      RecordStatus     @default(ACTIVE)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  users       User[]           @relation("UserPrimaryRole")
  employees   Employee[]       @relation("EmployeeRole")
  permissions RolePermission[]
  historyFrom RoleHistory[]    @relation("RoleHistoryFrom")
  historyTo   RoleHistory[]    @relation("RoleHistoryTo")

  @@map("roles")
}

model Permission {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String                   @default("General")
  resource    String
  action      String
  description String?
  createdAt   DateTime                 @default(now()) @map("created_at")
  roles       RolePermission[]
  overrides   UserPermissionOverride[]
  history     PermissionHistory[]

  @@unique([resource, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  userId       String         @map("user_id") @db.Uuid
  permissionId String         @map("permission_id") @db.Uuid
  effect       OverrideEffect
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_overrides")
}

model UserDataScope {
  userId    String    @map("user_id") @db.Uuid
  resource  String
  scope     DataScope
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, resource])
  @@map("user_data_scopes")
}

model RoleHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fromRoleId   String?  @map("from_role_id") @db.Uuid
  toRoleId     String   @map("to_role_id") @db.Uuid
  changedById  String?  @map("changed_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation("RoleHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  fromRole     Role?    @relation("RoleHistoryFrom", fields: [fromRoleId], references: [id], onDelete: SetNull)
  toRole       Role     @relation("RoleHistoryTo", fields: [toRoleId], references: [id], onDelete: Restrict)
  changedBy    User?    @relation("RoleHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("role_history")
}

model PermissionHistory {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  roleId         String?         @map("role_id") @db.Uuid
  permissionId   String          @map("permission_id") @db.Uuid
  previousEffect String?         @map("previous_effect")
  newEffect      String          @map("new_effect")
  changedById    String?         @map("changed_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  user           User?           @relation("PermissionHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  permission     Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  changedBy      User?           @relation("PermissionHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roleId])
  @@map("permission_history")
}

model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent") @db.Text
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  tokenHash String                @unique @map("token_hash")
  purpose   PasswordTokenPurpose  @default(RESET)
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purpose, usedAt])
  @@map("password_reset_tokens")
}

model MasterDataItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryKey    String          @map("category_key")
  name           String
  nameNormalized String          @map("name_normalized")
  code           String?
  description    String?
  parentId       String?         @map("parent_id") @db.Uuid
  status         RecordStatus    @default(ACTIVE)
  sortOrder      Int             @default(0) @map("sort_order")
  isSystem       Boolean         @default(false) @map("is_system")
  behaviorKey    String?         @map("behavior_key")
  extras         Json?
  createdById    String?         @map("created_by_id") @db.Uuid
  updatedById    String?         @map("updated_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  parent         MasterDataItem? @relation("MasterDataTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       MasterDataItem[] @relation("MasterDataTree")
  createdBy      User?           @relation("MasterDataCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("MasterDataUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  designationEmployees      Employee[] @relation("EmployeeDesignation")
  employmentTypeEmployees   Employee[] @relation("EmployeeEmploymentType")
  employmentStatusEmployees Employee[] @relation("EmployeeEmploymentStatus")
  categorizedServiceItems   ServiceItem[]        @relation("ServiceItemCategory")
  scopedServiceItems        ServiceItemCountry[] @relation("ServiceItemCountryMaster")
  packages                  Package[]            @relation("PackageCountry")

  @@unique([categoryKey, nameNormalized])
  @@unique([categoryKey, code])
  @@index([categoryKey, status, sortOrder])
  @@index([parentId])
  @@index([createdAt])
  @@map("master_data_items")
}

model ServiceItem {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String               @unique @map("name_normalized")
  description    String?              @db.Text
  defaultPrice   Decimal              @map("default_price") @db.Decimal(14, 2)
  categoryId     String               @map("category_id") @db.Uuid
  status         RecordStatus         @default(ACTIVE)
  createdById    String?              @map("created_by_id") @db.Uuid
  updatedById    String?              @map("updated_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")
  category            MasterDataItem       @relation("ServiceItemCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  countries           ServiceItemCountry[]
  packageVersionItems PackageVersionItem[]
  offerItems          ServiceOfferItem[]
  createdBy           User?                @relation("ServiceItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?                @relation("ServiceItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([categoryId, status])
  @@index([status, name])
  @@map("service_items")
}

model ServiceItemCountry {
  serviceItemId String         @map("service_item_id") @db.Uuid
  countryId     String         @map("country_id") @db.Uuid
  serviceItem   ServiceItem    @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  country       MasterDataItem @relation("ServiceItemCountryMaster", fields: [countryId], references: [id], onDelete: Restrict)

  @@id([serviceItemId, countryId])
  @@index([countryId])
  @@map("service_item_countries")
}

model Package {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  nameNormalized   String           @unique @map("name_normalized")
  description      String?          @db.Text
  countryId        String?          @map("country_id") @db.Uuid
  status           RecordStatus     @default(ACTIVE)
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  createdById      String?          @map("created_by_id") @db.Uuid
  updatedById      String?          @map("updated_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  country          MasterDataItem?  @relation("PackageCountry", fields: [countryId], references: [id], onDelete: Restrict)
  currentVersion   PackageVersion?  @relation("PackageCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         PackageVersion[] @relation("PackageVersions")
  offers           ServiceOffer[]
  createdBy        User?            @relation("PackageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?            @relation("PackageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, name])
  @@index([countryId])
  @@map("packages")
}

model PackageVersion {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId       String               @map("package_id") @db.Uuid
  versionNumber   Int                  @map("version_number")
  price           Decimal              @db.Decimal(14, 2)
  individualTotal Decimal              @map("individual_total") @db.Decimal(14, 2)
  saving          Decimal              @db.Decimal(14, 2)
  createdById     String?              @map("created_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  package         Package              @relation("PackageVersions", fields: [packageId], references: [id], onDelete: Cascade)
  currentFor      Package?             @relation("PackageCurrentVersion")
  items           PackageVersionItem[]
  offers          ServiceOffer[]
  createdBy       User?                @relation("PackageVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([packageId, versionNumber])
  @@index([packageId, createdAt])
  @@map("package_versions")
}

model PackageVersionItem {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageVersionId String               @map("package_version_id") @db.Uuid
  serviceItemId    String               @map("service_item_id") @db.Uuid
  inclusion        PackageItemInclusion
  unitPrice        Decimal              @map("unit_price") @db.Decimal(14, 2)
  sortOrder        Int                  @default(0) @map("sort_order")
  packageVersion   PackageVersion       @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  serviceItem      ServiceItem          @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)

  @@unique([packageVersionId, serviceItemId])
  @@index([serviceItemId])
  @@map("package_version_items")
}

enum ServiceOfferStatus {
  DRAFT
  GENERATED
  SENT
  ACCEPTED
  PAYMENT_PENDING
  PARTIALLY_PAID
  PAID
  REJECTED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  AMOUNT
  PERCENTAGE
}

enum OfferLineKind {
  PACKAGE_INCLUDED
  PACKAGE_OPTIONAL
  SERVICE
  ADDITIONAL
  CUSTOM_SERVICE
  CUSTOM_CHARGE
}

model ServiceOffer {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId                 String             @map("lead_id") @db.Uuid
  status                 ServiceOfferStatus @default(DRAFT)
  sourcePackageId        String?            @map("source_package_id") @db.Uuid
  sourcePackageVersionId String?            @map("source_package_version_id") @db.Uuid
  packageName            String?            @map("package_name")
  versionNumber          Int?               @map("version_number")
  packageDefaultPrice    Decimal?           @map("package_default_price") @db.Decimal(14, 2)
  packagePrice           Decimal?           @map("package_price") @db.Decimal(14, 2)
  individualTotal        Decimal            @default(0) @map("individual_total") @db.Decimal(14, 2)
  saving                 Decimal            @default(0) @db.Decimal(14, 2)
  fileOpeningDefault     Decimal?           @map("file_opening_default") @db.Decimal(14, 2)
  fileOpeningCharge      Decimal            @default(0) @map("file_opening_charge") @db.Decimal(14, 2)
  grossTotal             Decimal            @default(0) @map("gross_total") @db.Decimal(14, 2)
  lineDiscountTotal      Decimal            @default(0) @map("line_discount_total") @db.Decimal(14, 2)
  subtotal               Decimal            @default(0) @db.Decimal(14, 2)
  overallDiscountType    DiscountType?      @map("overall_discount_type")
  overallDiscountValue   Decimal?           @map("overall_discount_value") @db.Decimal(14, 2)
  overallDiscountAmount  Decimal            @default(0) @map("overall_discount_amount") @db.Decimal(14, 2)
  overallDiscountReason  String?            @map("overall_discount_reason") @db.Text
  finalPayable           Decimal            @map("final_price") @db.Decimal(14, 2)
  expectedDealValue      Decimal?           @map("expected_deal_value") @db.Decimal(14, 2)
  initialPayment         Decimal?           @map("initial_payment") @db.Decimal(14, 2)
  generatedAt            DateTime?          @map("generated_at")
  generatedById          String?            @map("generated_by_id") @db.Uuid
  offerVersion           Int                @default(1) @map("offer_version")
  revisedFromId          String?            @map("revised_from_id") @db.Uuid
  sentAt                 DateTime?          @map("sent_at")
  sentById               String?            @map("sent_by_id") @db.Uuid
  validUntil             DateTime?          @map("valid_until")
  acceptedAt             DateTime?          @map("accepted_at")
  acceptedById           String?            @map("accepted_by_id") @db.Uuid
  /// Version, total, and selected services captured at the moment of acceptance.
  acceptedSnapshot       Json?              @map("accepted_snapshot")
  rejectedAt             DateTime?          @map("rejected_at")
  rejectionReason        String?            @map("rejection_reason") @db.Text
  cancelledAt            DateTime?          @map("cancelled_at")
  cancelledById          String?            @map("cancelled_by_id") @db.Uuid
  cancelReason           String?            @map("cancel_reason") @db.Text
  createdById            String?            @map("created_by_id") @db.Uuid
  updatedById            String?            @map("updated_by_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at")
  lead                   Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sourcePackage          Package?           @relation(fields: [sourcePackageId], references: [id], onDelete: SetNull)
  sourceVersion          PackageVersion?    @relation(fields: [sourcePackageVersionId], references: [id], onDelete: Restrict)
  items                  ServiceOfferItem[]
  installments           ServiceOfferInstallment[]
  payments               Payment[]
  generatedBy            User?              @relation("ServiceOfferGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  createdBy              User?              @relation("ServiceOfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?              @relation("ServiceOfferUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sentBy                 User?              @relation("ServiceOfferSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  acceptedBy             User?              @relation("ServiceOfferAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  cancelledBy            User?              @relation("ServiceOfferCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  revisedFrom            ServiceOffer?      @relation("ServiceOfferRevision", fields: [revisedFromId], references: [id], onDelete: Restrict)
  revisions              ServiceOffer[]     @relation("ServiceOfferRevision")
  statusHistory          ServiceOfferStatusHistory[]

  @@unique([leadId, offerVersion])
  @@index([leadId, createdAt])
  @@index([leadId, status])
  @@index([status, validUntil])
  @@index([sourcePackageVersionId])
  @@map("service_offers")
}

model ServiceOfferStatusHistory {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOfferId String              @map("service_offer_id") @db.Uuid
  fromStatus     ServiceOfferStatus? @map("from_status")
  toStatus       ServiceOfferStatus  @map("to_status")
  reason         String?             @db.Text
  changedById    String?             @map("changed_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  serviceOffer   ServiceOffer        @relation(fields: [serviceOfferId], references: [id], onDelete: Cascade)
  changedBy      User?               @relation("ServiceOfferStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([serviceOfferId, createdAt])
