# Shared defaults for every mode. Do not set NODE_ENV in this file.
# `npm run dev` loads this file, then `.env.development` overrides it.
# `npm run prod` loads this file, then `.env.production` overrides it.
# Secrets and origins belong in those mode files, not here.

PORT=4000
RESET_TOKEN_HOURS=2
INVITE_TOKEN_HOURS=72
MIN_PASSWORD_LENGTH=8
WEBSITE_WEBHOOK_RATE_LIMIT=60

SEED_ADMIN_EMAIL=admin@campusly.com
SEED_ADMIN_USERNAME=root

EMAIL_FROM_NAME=Campusly CRM
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_IMAP_ENABLED=true
EMAIL_IMAP_POLL_SECONDS=30
EMAIL_AUTO_CREATE_LEAD=true
EMAIL_WAITING_REPLY_HOURS=24
EMAIL_WAITING_REPLY_POLL_MINUTES=15

CLOUDINARY_FOLDER=education-crm
META_DISPLAY_NAME=Campusly CRM
META_GRAPH_VERSION=v21.0
