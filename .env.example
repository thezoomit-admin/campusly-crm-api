PORT=4000
# Comma-separated admin app origins (CORS + Socket.IO). Dev UI is usually :4001.
CLIENT_ORIGIN=http://localhost:4001,http://localhost:5173
# Public web app URL used in invite / password-reset emails (defaults to first CLIENT_ORIGIN)
APP_PUBLIC_URL=http://localhost:4001
RESET_TOKEN_HOURS=2
INVITE_TOKEN_HOURS=72
MIN_PASSWORD_LENGTH=8

# Comma-separated marketing website origins (CORS for public form options / browser posts)
WEBSITE_ORIGINS=http://localhost:3000,https://www.example.com

# Shared secret for POST /api/webhooks/website (X-Webhook-Key / Bearer). Required in production.
WEBSITE_WEBHOOK_SECRET=replace-with-long-random-secret
WEBSITE_WEBHOOK_RATE_LIMIT=60

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

SEED_ADMIN_EMAIL=admin@campusly.com
SEED_ADMIN_USERNAME=root
SEED_ADMIN_PASSWORD=12345678
SEED_ADMIN_RESET=true

# WhatsApp Business (Meta Cloud API) — webhook: GET/POST /api/webhooks/whatsapp
# Without ACCESS_TOKEN + PHONE_NUMBER_ID, outgoing messages run in mock mode (non-production only).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token
WHATSAPP_GRAPH_VERSION=v21.0
# true = auto-create leads for unknown numbers with useful info; false = manual review in the inbox
WHATSAPP_AUTO_CREATE_LEAD=true
WHATSAPP_ALLOW_VIDEO=false
WHATSAPP_ALLOW_VOICE=false
WHATSAPP_DEFAULT_TEMPLATE=hello_world
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_US

# Official mailbox (CRM-013). Webhook: POST /api/webhooks/email
# Without SMTP_HOST, outgoing mail runs in mock mode (non-production only).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Campusly
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_WEBHOOK_SECRET=
# true = auto-create a lead when the sender email is unknown; false = manager review in Email Inbox
EMAIL_AUTO_CREATE_LEAD=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=education-crm

# Max total discount (% of gross) without the service:discount_approve permission
SERVICE_OFFER_DISCOUNT_LIMIT_PERCENT=10
# Days a Sent offer stays valid before it expires automatically (0 = never expires)
SERVICE_OFFER_VALIDITY_DAYS=14
# Allow [Mark as Accepted] on a Generated offer without first marking it Sent
SERVICE_OFFER_ALLOW_ACCEPT_WITHOUT_SENDING=false
